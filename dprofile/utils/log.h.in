    */
#define DPROFILE_WARN_C(...)                                     \
{                                                           \
if constexpr(DPROFILE_PRINT_WITH_COLOR)                          \
    fprintf(stdout,                                         \
        "\033[103m\033[97m DPROFILE Warn \033[0m [%s @ %p]  ",   \
        demangle(typeid(*this).name()).c_str(), this        \
    );                                                      \
else                                                        \
    fprintf(stdout,                                         \
        "|-DPROFILE Warn-| [%s @ %p]  ",                         \
        demangle(typeid(*this).name()).c_str(), this        \
    );                                                      \
fprintf(stdout, __VA_ARGS__);                               \
fprintf(stdout, "\n");                                      \
}

/*!
    * \brief   print warn message with class info and specific code position
    */
#define DPROFILE_WARN_DETAIL(...)    \
{                               \
DPROFILE_WARN(__VA_ARGS__)           \
_DPROFILE_PRINT_DPROFILEITION(stderr)     \
}

/*!
    * \brief   print warn message with class info and specific code position
    * \note    this macro should only be expanded within c++ class
    */
#define DPROFILE_WARN_C_DETAIL(...)  \
{                               \
DPROFILE_WARN_C(__VA_ARGS__)         \
_DPROFILE_PRINT_DPROFILEITION(stderr)     \
}
#else
#define DPROFILE_WARN(...)
#define DPROFILE_WARN_C(...)
#define DPROFILE_WARN_DETAIL(...)
#define DPROFILE_WARN_C_DETAIL(...)
#endif

